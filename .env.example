# ORBIT Machine Guardian — example environment file.
# Copy to .env and fill in real values. NEVER commit the real .env.

# Optional: AMD ROCm / HIP visibility filtering on cloud instances
HIP_VISIBLE_DEVICES=0

# Optional: override the default execution device (auto|cpu|cuda|rocm|mps)
ORBIT_DEVICE=auto

# Optional: AMD Token Factory advisory model (advisory only; never authoritative).
# Copy .env.example to .env and fill in your key. .env is git-ignored; never commit it.
# RADEON_API_KEY=
# RADEON_MODEL=DeepSeek-V4-Flash
# Optional: request timeout in seconds. The live endpoint verified 2026-10-18
# answered in over 30s, so the default is 120s.
# RADEON_TIMEOUT_S=120
